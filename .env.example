# Copy this file to .env and fill in your values. Never commit .env.
# Token: YouTrack -> Profile -> Account Security -> New token (scope: YouTrack)
# Root URL only, e.g. https://example.youtrack.cloud (no trailing path)
YOUTRACK_HOST=
# Paste the whole token exactly as YouTrack shows it (it already starts with "perm")
YOUTRACK_TOKEN=
